# Copie para .env local; nunca versione credenciais reais.
# Em produção, o Render injeta DATABASE_URL via conexão privada do PostgreSQL.
DATABASE_URL=postgresql+psycopg://quita:senha@localhost:5432/quita
QUITA_ADMIN_API_KEY=change-me-to-a-long-random-secret
QUITA_REQUEST_TIMEOUT_SECONDS=8
QUITA_MAX_RETRIES_PER_PROVIDER=1
